generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  urls          Url[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Url {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  slug          String    @unique @db.VarChar(64)
  destination   String    @db.Text
  customAlias   Boolean   @default(false)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  clickCount    Int       @default(0)
  lastClickedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  clicks        Click[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model Click {
  id        BigInt   @id @default(autoincrement())
  urlId     String
  url       Url      @relation(fields: [urlId], references: [id], onDelete: Cascade)
  clickedAt DateTime @default(now())
  referer   String?  @db.Text
  country   String?  @db.VarChar(2)
  city      String?  @db.VarChar(128)
  browser   String?  @db.VarChar(64)
  os        String?  @db.VarChar(64)
  device    String?  @db.VarChar(32)
  userAgent String?  @db.Text
  ipHash    String?  @db.VarChar(128)
  isBot     Boolean  @default(false)

  @@index([urlId, clickedAt(sort: Desc)])
  @@index([clickedAt(sort: Desc)])
}
